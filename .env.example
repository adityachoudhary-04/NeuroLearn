# ==============================================================================
# PDF RAG & Learning Assistant - Environment Configuration
# ==============================================================================

# Free LLM & Embedding API Options:
# 1. Google Gemini API (Free tier from Google AI Studio - https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Groq Cloud (Free tier with ultra-fast Llama 3 - https://console.groq.com/)
GROQ_API_KEY=

# Paid / Future API Providers (OpenAI, Anthropic):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Active Providers
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-3.8-flash

DEFAULT_EMBEDDING_PROVIDER=gemini
DEFAULT_EMBEDDING_MODEL=gemini-embedding-001

# Chunking & Retrieval Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5
